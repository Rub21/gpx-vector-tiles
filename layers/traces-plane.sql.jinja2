{# generated by gen-layers.sh from traces.sql.jinja2, do not edit #}
{% set mode = 4 %}
-- Trace lines in the tile, cut into pieces by direction of travel, so the
-- style can color them like the PNG tiles (datamaps lines-directional).
--
-- The tile does not say which trace a line is from. Many traces follow
-- the same road, and a line per trace made the tiles big (12 MB at z9).
-- Every edge is snapped to a grid of half a pixel (8 of 4096 tile units)
-- and the edges that fall on the same place are kept once, with n: how
-- many traces go through it, like a pixel of the PNG tiles.
--
-- Low zooms read the simplified copies that import fills (trace_segments_z5,
-- _z8, _z11, _z14 with -simplified-zooms 5,8,11,14: one pixel at that
-- zoom). Vector tiles are drawn sharp and often at double resolution, so a
-- tile reads the copy made for two zooms deeper, or the lines look angular.
-- Only recent traces: this year and the recent_years before it.
-- The tables are partitioned by year, so the query reads only those
-- partitions. Change the number here and run ./gen-layers.sh, no re-import needed.
{% set recent_years = 2 %}
-- mode: 0 unknown, 1 walk, 2 bike, 3 vehicle, 4 plane. The generated
-- layer files (layers/traces-<mode>.sql.jinja2) set it on their first
-- line; this file alone renders the walk layer.
{% if mode is not defined %}{% set mode = 1 %}{% endif %}
{% set where = "geom && " ~ bbox ~ " AND year >= extract(year FROM now())::int - " ~ recent_years ~ " AND mode = " ~ mode %}
{% set table = "trace_segments_z5" if zoom <= 3 else "trace_segments_z8" if zoom <= 6 else "trace_segments_z11" if zoom <= 9 else "trace_segments_z14" if zoom <= 12 else "trace_segments" %}
{% set grid = 8 %}
{% if zoom <= 12 %}
-- The simplified copies are already cut at the GPS jumps, and their long
-- edges come from the simplification, so nothing is dimmed: fade 10.
WITH edges AS (
  SELECT (ST_DumpSegments(g)).geom AS g, 10 AS fade
  FROM (
    SELECT ST_RemoveRepeatedPoints(ST_SnapToGrid(ST_AsMVTGeom(geom, {{bbox}}, {{extent}}, {{buffer}}, true), {{grid}})) AS g
    FROM {{table}}
    WHERE {{where}}
  ) clipped
  WHERE g IS NOT NULL AND GeometryType(g) IN ('LINESTRING', 'MULTILINESTRING')
),
{% else %}
-- The full lines keep the GPS jumps. Like datamaps -g and gpxtiler serve,
-- an edge longer than about 15 m at z16 (x1.5 for each zoom out) gets
-- dimmer: brightness / (length / limit), with gamma 0.5, so the opacity
-- is sqrt(limit / length). Edges over 200 times the limit are dropped.
-- The length is measured in meters (Web Mercator) BEFORE clipping to the
-- tile: a 1000 km jump clipped to the tile would look like a short edge.
{% set limit_m = 14.9 * (1.5 ** (16 - zoom)) %}
WITH edges AS (
  SELECT ST_SnapToGrid(ST_AsMVTGeom(g, {{bbox}}, {{extent}}, {{buffer}}, true), {{grid}}) AS g,
         least(10, greatest(1, round(10 * sqrt(least(1.0, {{limit_m}} / ST_Length(g))))))::int AS fade
  FROM (
    SELECT (ST_DumpSegments(geom)).geom AS g
    FROM {{table}}
    WHERE {{where}}
  ) s
  WHERE g && {{bbox}}
    AND ST_Length(g) > 0
    AND ST_Length(g) < 200 * {{limit_m}}
),
{% endif %}
dirs AS (
  -- dir: direction of travel in 32 steps. Tile y grows down, so north is
  -- start y - end y.
  SELECT g, fade,
         floor((degrees(atan2(ST_Y(ST_StartPoint(g)) - ST_Y(ST_EndPoint(g)),
                              ST_X(ST_EndPoint(g)) - ST_X(ST_StartPoint(g)))) + 360) / 11.25)::int % 32 AS dir
  FROM edges
  WHERE g IS NOT NULL AND GeometryType(g) = 'LINESTRING'
    AND NOT ST_Equals(ST_StartPoint(g), ST_EndPoint(g))
),
uniq AS (
  -- The same edge from many traces is kept once. n: how many, up to 10.
  SELECT g, dir, fade, least(count(*), 10)::int AS n
  FROM dirs
  GROUP BY g, dir, fade
)
SELECT ST_LineMerge(ST_Collect(g)) AS geom, dir, fade, n
FROM uniq
GROUP BY dir, fade, n
