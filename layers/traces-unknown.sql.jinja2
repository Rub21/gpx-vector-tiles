{# generated by gen-layers.sh from traces.sql.jinja2, do not edit #}
{% set mode_sql = "mode = 0" %}
-- Trace lines of the tile, cut by direction of travel. The same edge from
-- many traces is kept once, with n = how many traces go through it.
--
-- Layers: up to z9, "traces" (every mode but plane) and "plane"; from z10
-- one layer per mode. Zoom ranges in config.yaml.
-- Only this year and the recent_years before it.
{% set recent_years = 2 %}
-- mode_sql: set by the generated layer files (gen-layers.sh). Alone, walk.
{% if mode_sql is not defined %}{% set mode_sql = "mode = 1" %}{% endif %}
{% set where = "geom && " ~ bbox ~ " AND year >= extract(year FROM now())::int - " ~ recent_years ~ " AND " ~ mode_sql %}
-- Simplified copies (gpxtiler import -simplified-zooms 5,8,11,14) up to z12.
{% set table = "trace_segments_z5" if zoom <= 3 else "trace_segments_z8" if zoom <= 6 else "trace_segments_z11" if zoom <= 9 else "trace_segments_z14" if zoom <= 12 else "trace_segments" %}
-- Snap grid, in tile units (16 per pixel): 2 px up to z6, 1 px to z9, half from z10.
{% set grid = 32 if zoom <= 6 else 16 if zoom <= 9 else 8 %}
-- Low zooms keep only edges with min_n traces or more.
{% set min_n = 3 if zoom <= 4 else 2 if zoom <= 6 else 1 %}
{% if zoom <= 12 %}
-- The copies are cut at the GPS jumps: nothing to dim, fade 10.
WITH edges AS (
  SELECT (ST_DumpSegments(g)).geom AS g, 10 AS fade
  FROM (
    SELECT ST_RemoveRepeatedPoints(ST_SnapToGrid(ST_AsMVTGeom(geom, {{bbox}}, {{extent}}, {{buffer}}, true), {{grid}})) AS g
    FROM {{table}}
    WHERE {{where}}
  ) clipped
  WHERE g IS NOT NULL AND GeometryType(g) IN ('LINESTRING', 'MULTILINESTRING')
),
{% else %}
-- Full lines keep the GPS jumps. An edge longer than limit_m (15 m at z16,
-- x1.5 per zoom out) gets fade = 10 * sqrt(limit / length), like datamaps -g.
-- Edges over 200 times the limit are dropped. Length in meters, before clipping.
{% set limit_m = 14.9 * (1.5 ** (16 - zoom)) %}
WITH edges AS (
  SELECT ST_SnapToGrid(ST_AsMVTGeom(g, {{bbox}}, {{extent}}, {{buffer}}, true), {{grid}}) AS g,
         least(10, greatest(1, round(10 * sqrt(least(1.0, {{limit_m}} / ST_Length(g))))))::int AS fade
  FROM (
    SELECT (ST_DumpSegments(geom)).geom AS g
    FROM {{table}}
    WHERE {{where}}
  ) s
  WHERE g && {{bbox}}
    AND ST_Length(g) > 0
    AND ST_Length(g) < 200 * {{limit_m}}
),
{% endif %}
dirs AS (
  -- dir: direction of travel in 32 steps. Tile y grows down.
  SELECT g, fade,
         floor((degrees(atan2(ST_Y(ST_StartPoint(g)) - ST_Y(ST_EndPoint(g)),
                              ST_X(ST_EndPoint(g)) - ST_X(ST_StartPoint(g)))) + 360) / 11.25)::int % 32 AS dir
  FROM edges
  WHERE g IS NOT NULL AND GeometryType(g) = 'LINESTRING'
    AND NOT ST_Equals(ST_StartPoint(g), ST_EndPoint(g))
),
uniq AS (
  -- One row per edge. n: traces through it, up to 10.
  SELECT g, dir, fade, least(count(*), 10)::int AS n
  FROM dirs
  GROUP BY g, dir, fade
  HAVING count(*) >= {{min_n}}
)
SELECT ST_LineMerge(ST_Collect(g)) AS geom, dir, fade, n
FROM uniq
GROUP BY dir, fade, n
